# ERP BY ANMOL - environment template
# Copy this file to .env for local development.
# Never commit real production credentials or secrets.

# --------------------------------------------------
# Application
# --------------------------------------------------
NODE_ENV=development
PORT=4000

# --------------------------------------------------
# Core data services
# --------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/erp_by_anmol
REDIS_URL=redis://localhost:6379

# --------------------------------------------------
# Authentication and security
# Production: replace every value below with a unique
# cryptographically-random secret of at least 64 chars.
# --------------------------------------------------
JWT_ACCESS_SECRET=replace-with-64-char-random-secret
JWT_REFRESH_SECRET=replace-with-different-64-char-random-secret
MFA_ENCRYPTION_KEY=replace-with-another-64-char-random-secret
WORKER_CALLBACK_SECRET=replace-with-another-64-char-random-secret
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=

# --------------------------------------------------
# Browser / frontend URLs
# --------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PASSWORD_RESET_URL=http://localhost:5173/reset-password
VITE_API_URL=http://localhost:4000/api

# --------------------------------------------------
# Initial Platform Super Admin seed
# Change the password immediately after first setup.
# --------------------------------------------------
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_PASSWORD=ChangeThisImmediately123!

# --------------------------------------------------
# Transactional email (Resend)
# Required for real production email delivery.
# --------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="ERP BY ANMOL <no-reply@example.com>"

# --------------------------------------------------
# Razorpay
# Use test keys locally and live keys only in production.
# --------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --------------------------------------------------
# Private object storage (AWS S3 or S3-compatible)
# S3_BUCKET is required in production.
# Leave S3_ENDPOINT empty when using AWS S3.
# --------------------------------------------------
S3_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --------------------------------------------------
# Malware scanning
# Production must use FILE_SCAN_MODE=required and a
# reachable ClamAV service.
# --------------------------------------------------
FILE_SCAN_MODE=optional
CLAMAV_HOST=
CLAMAV_PORT=3310

# --------------------------------------------------
# Background worker -> API callbacks
# --------------------------------------------------
INTERNAL_API_URL=http://localhost:4000/api
